---
import TermsBlocks from '@/components/legal/TermsBlocks.astro';
import type { SupportedLang } from '@/lib/seo';
import type { TermsAndConditionsContent, TermsBlock } from '@/models/legal';

interface Props {
  terms: TermsAndConditionsContent;
  lang: SupportedLang;
  /** When `false`, omits the page `<h1>` and date (e.g. dialog already shows the title in chrome). */
  showDocumentTitle?: boolean;
}

const { terms, lang, showDocumentTitle = true } = Astro.props;
---

<article class="prose legal-doc max-w-none">
  {
    showDocumentTitle ? (
      <>
        <h1>{terms.title}</h1>
        <p>{terms.date}</p>
      </>
    ) : null
  }

  {
    terms.sections.map((section) => (
      <>
        <h2>{section.title}</h2>
        {section.blocks ? <TermsBlocks blocks={section.blocks as TermsBlock[]} lang={lang} /> : null}
        {
          section.subsections?.map((subsection) => (
            <>
              <h3>{subsection.title}</h3>
              <TermsBlocks blocks={subsection.blocks as TermsBlock[]} lang={lang} />
            </>
          ))
        }
      </>
    ))
  }
</article>
